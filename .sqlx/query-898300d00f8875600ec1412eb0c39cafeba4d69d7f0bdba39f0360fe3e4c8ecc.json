  "query": "\n            SELECT \n                id, organization_id, user_id, network, type as event_type, \n                address, webhook_url, subscription_type, active, \n                confirmation_blocks, created_at, updated_at\n            FROM subscriptions \n            WHERE organization_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
